{
  "name": "dom-diff-guard",
  "version": "0.1.0",
  "description": "Runtime overflow guard and auto-remediation for dynamic and AI-generated UIs.",
  "license": "MIT",
  "keywords": [
    "overflow",
    "layout",
    "resize-observer",
    "react",
    "ai-ui"
  ],
  "sideEffects": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "author": "Noel Eruotor <noeleruotor23@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeljr2306/dom-diff-guard.git"
  },
  "homepage": "https://github.com/noeljr2306/dom-diff-guard#readme",
  "bugs": {
    "url": "https://github.com/noeljr2306/dom-diff-guard/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^29.1.1",
    "publint": "^0.3.24",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
